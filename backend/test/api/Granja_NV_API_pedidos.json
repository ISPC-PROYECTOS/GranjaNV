  "item": [
    {
      "name": "00 - Login Administrador",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code es 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var data = pm.response.json();",
              "pm.collectionVariables.set('jwt_token', data.access);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"admin@granjanv.com.ar\",\n    \"password\": \"adminadmin\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login/",
          "host": ["{{base_url}}"],
          "path": ["auth", "login", ""]
        }
      }
    },
    {
      "name": "VP-01 Alta rápida de cliente",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('VP-01: Status code es 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var data = pm.response.json();",
              "pm.test('VP-01: Nombre normalizado en mayúsculas', function () {",
              "    pm.expect(data.nombre).to.eql('CLAUDIO N');",
              "});",
              "pm.collectionVariables.set('cliente_id', data.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"nombre\": \"Claudio N\",\n    \"apellido\": \"Molina\",\n    \"telefono\": \"3514040404\",\n    \"direccion\": \"Moreno 123\",\n    \"tipo\": \"MINORISTA\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/clientes/clientes/",
          "host": ["{{base_url}}"],
          "path": ["clientes", "clientes", ""]
        }
      }
    },
