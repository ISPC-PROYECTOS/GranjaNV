    "description": "Suite de pruebas automatizadas para el módulo de ventas y pedidos de Granja NV ejecutables vía Newman CLI.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
