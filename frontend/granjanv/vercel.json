{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://granjanv.onrender.com/api/$1"
    },
    {
      "source": "/admin/(.*)",
      "destination": "https://granjanv.onrender.com/admin/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "https://granjanv.onrender.com/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}