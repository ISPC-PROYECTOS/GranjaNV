{
  "info": {
    "_postman_id": "granja-nv-produccion-collection",
    "name": "Granja_NV_API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Producción",
      "item": [
        {
          "name": "TC-01 - Registro de Huevos Exitoso",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"galpon\": 1,\n  \"huevos_rotos\": 12,\n  \"items\": [\n    {\n      \"tipo_huevo\": \"COLOR_1\",\n      \"cantidad_maples\": 15\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/produccion/huevos/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "produccion",
                "huevos",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 201 Created', function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-02 - Registro de Huevos Negativo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"galpon\": 1,\n  \"items\": [\n    {\n      \"tipo_huevo\": \"COLOR_1\",\n      \"cantidad_maples\": -5\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/produccion/huevos/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "produccion",
                "huevos",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 400 Bad Request', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-03 - Mortalidad Exitosa",
